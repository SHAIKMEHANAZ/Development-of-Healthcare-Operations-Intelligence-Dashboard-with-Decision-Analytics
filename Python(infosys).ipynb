        "## Question 15: Create a Simple Calculator\n\n",
        "**Problem Statement:** Write a Python function that performs addition, subtraction, multiplication, and division based on the selected operator.\n\n",
        "**Example Input:**\n\n",
        "`20, 5, and operators +, -, *, /`\n\n",
        "**Expected Output:**\n\n",
        "```text\n",
        "Addition: 25\nSubtraction: 15\nMultiplication: 100\nDivision: 4.0",
        "\n```"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "Addition: 25\n",
            "Subtraction: 15\n",
            "Multiplication: 100\n",
            "Division: 4.0\n"
          ]
        }
      ],
      "source": [
        "def calculator(a, b, operator):\n",
        "    if operator == \"+\":\n",
        "        return a + b\n",
        "    elif operator == \"-\":\n",
        "        return a - b\n",
        "    elif operator == \"*\":\n",
        "        return a * b\n",
        "    elif operator == \"/\":\n",
        "        return a / b\n",
        "    else:\n",
        "        return \"Invalid operator\"\n",
        "\n",
        "\n",
        "print(\"Addition:\", calculator(20, 5, \"+\"))\n",
        "print(\"Subtraction:\", calculator(20, 5, \"-\"))\n",
        "print(\"Multiplication:\", calculator(20, 5, \"*\"))\n",
        "print(\"Division:\", calculator(20, 5, \"/\"))\n"
      ]
    }
